{
  "info": {
    "_postman_id": "11111111-1111-4111-8111-111111111111",
    "name": "Events Collection",
    "description": "Fixture: collection-level and request-level events, examples, url variables, form-data file field.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('userId', '42');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "name", "value": "Ada", "type": "text" },
            { "key": "avatar", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "https://api.example.com/users/:id",
          "protocol": "https",
          "host": ["api", "example", "com"],
          "path": ["users", ":id"],
          "variable": [
            { "key": "id", "value": "42" }
          ]
        },
        "description": "Creates a user."
      },
      "response": [
        {
          "name": "Created",
          "originalRequest": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "https://api.example.com/users/42",
              "protocol": "https",
              "host": ["api", "example", "com"],
              "path": ["users", "42"]
            }
          },
          "status": "Created",
          "code": 201,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "cookie": [],
          "body": "{\n  \"id\": 42,\n  \"name\": \"Ada\"\n}"
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('collectionRan', true);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "console.log('collection tests ran');"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://api.example.com" }
  ]
}
