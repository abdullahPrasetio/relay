{
  "name": "relay",
  "productName": "Relay",
  "version": "0.2.0",
  "description": "Relay — a modern local API client (Postman-style) built with Electron + React + Vite",
  "main": "dist-electron/main.js",
  "bin": {
    "relay": "cli/relay.mjs"
  },
  "type": "module",
  "author": "Relay",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:vite": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:vite && playwright test",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build:vite",
    "dist": "vite build && electron-builder --mac --arm64",
    "dist:universal": "vite build && electron-builder --mac --universal",
    "dist:dir": "vite build && electron-builder --mac --arm64 --dir",
    "dist:win": "vite build && electron-builder --win nsis --x64",
    "dist:linux": "vite build && electron-builder --linux AppImage --x64",
    "release": "vite build && electron-builder --mac --arm64 --publish always",
    "cli": "node cli/relay.mjs",
    "build:core": "npx esbuild packages/core/src/cli.js --bundle --platform=node --format=esm --outfile=dist-core/relay-core.mjs --external:electron --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\""
  },
  "build": {
    "appId": "com.relay.apiclient",
    "productName": "Relay",
    "publish": {
      "provider": "github",
      "owner": "abdullahPrasetio",
      "repo": "relay"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Relay ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@monaco-editor/react": "^4.6.0",
    "crypto-js": "^4.2.0",
    "electron-updater": "^6.8.11",
    "graphql": "^17.0.2",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "moment": "^2.30.1",
    "monaco-editor": "^0.52.2",
    "mqtt": "^5.16.1",
    "socket.io-client": "^4.8.4",
    "socks-proxy-agent": "^8.0.5",
    "uuid": "^11.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "aedes": "^1.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  }
}
